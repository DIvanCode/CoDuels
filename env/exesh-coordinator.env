# Режим логирования Coordinator: prod, docker или dev.
ENV=prod
# Встроенный YAML-конфиг Coordinator.
CONFIG_PATH=/app/config/coordinator.yml
# Адрес HTTP API Coordinator.
HTTP_SERVER_ADDR=0.0.0.0:5253
# Адрес Prometheus metrics Coordinator.
HTTP_SERVER_METRICS_ADDR=0.0.0.0:9090

# Подключение Coordinator к PostgreSQL. Значения должны совпадать с exesh-postgres.env.
STORAGE_CONNECTION_STRING="host=exesh-postgres port=5432 database=exesh user=coordinator password=coduels-change-me"
# Максимальное ожидание инициализации БД Exesh.
STORAGE_INIT_TIMEOUT=60s

# Корень временного file storage Coordinator.
FILE_STORAGE_ROOT_DIR=/file_storage/coordinator
# Число обработчиков очистки временных bucket.
FILE_STORAGE_TRASHER_WORKERS=1
# Пауза сборщика просроченных bucket, секунд.
FILE_STORAGE_TRASHER_COLLECTOR_ITERATIONS_DELAY=60
# Пауза обработчика удаления, секунд.
FILE_STORAGE_TRASHER_WORKER_ITERATIONS_DELAY=5

# Имя артефакта скомпилированной программы.
JOB_FACTORY_OUTPUT_COMPILED_BINARY=bin
# Имя артефакта stdout программы.
JOB_FACTORY_OUTPUT_RUN_OUTPUT=output
# Срок жизни bucket с исходниками execution.
JOB_FACTORY_SOURCE_TTL_FILESTORAGE_BUCKET=30m
# Адрес file storage Coordinator для worker.
JOB_FACTORY_FILESTORAGE_ENDPOINT=http://coordinator:5253

# Интервал цикла планировщика execution.
EXECUTION_SCHEDULER_EXECUTIONS_INTERVAL=500ms
# Общая расчётная ёмкость планировщика.
EXECUTION_SCHEDULER_CAPACITY=7680000000
# Задержка перед повтором зависшего execution.
EXECUTION_SCHEDULER_EXECUTION_RETRY_AFTER=30s
# Лимит заранее обещанных worker заданий.
JOB_SCHEDULER_PROMISED_JOBS_LIMIT=5
# Интервал перепланирования обещаний.
JOB_SCHEDULER_PROMISE_RESCHEDULE_INTERVAL=100ms
# Время без heartbeat, после которого worker считается недоступным.
WORKER_POOL_WORKER_DIE_AFTER=1s

# Не отправлять события Exesh в Kafka.
DISPATCHER_KAFKA_ENABLED=false
# Kafka brokers отсутствуют.
DISPATCHER_BROKERS=
# Неактивное имя Kafka topic.
DISPATCHER_TOPIC=exesh.step-updates
# Kafka SASL отключён.
DISPATCHER_SASL_AUTH=false
DISPATCHER_SASL_USERNAME=
DISPATCHER_SASL_PASSWORD=
