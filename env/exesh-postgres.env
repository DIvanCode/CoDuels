# База данных Coordinator и dashboard.
POSTGRES_DB=exesh
# Владелец базы Exesh.
POSTGRES_USER=coordinator
# Пароль базы Exesh. Обязательно замените его также в exesh-coordinator.env
# и exesh-dashboard.env.
POSTGRES_PASSWORD=coduels-change-me
# Каталог данных PostgreSQL внутри именованного volume.
PGDATA=/var/lib/postgresql/data/pgdata
