# Часовой пояс дат в dashboard.
EXESH_DASHBOARD_TIME_ZONE=Europe/Moscow
# Общая строка подключения dashboard. Значения должны совпадать с exesh-postgres.env.
EXESH_DASHBOARD_DB_CONNECTION_STRING="host=exesh-postgres port=5432 database=exesh user=coordinator password=coduels-change-me"
# Отдельные поля имеют приоритет над общей строкой подключения.
EXESH_DASHBOARD_DB_HOST=exesh-postgres
EXESH_DASHBOARD_DB_PORT=5432
EXESH_DASHBOARD_DB_NAME=exesh
EXESH_DASHBOARD_DB_USER=coordinator
EXESH_DASHBOARD_DB_PASSWORD=coduels-change-me
