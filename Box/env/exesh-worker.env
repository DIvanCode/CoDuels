ENV=prod

# Среда запуска недоверенного кода; в production должна быть isolate.
RUNTIME=isolate

# Число обработчиков очистки временных файлов.
FILE_STORAGE_TRASHER_WORKERS=1
# Пауза сборщика просроченных файлов, секунд.
FILE_STORAGE_TRASHER_COLLECTOR_ITERATIONS_DELAY=60
# Пауза обработчика удаления, секунд.
FILE_STORAGE_TRASHER_WORKER_ITERATIONS_DELAY=5

# Срок жизни загруженного исходного bucket.
SOURCE_PROVIDER_FILESTORAGE_BUCKET_TTL=15m
# Срок жизни входного артефакта задания.
SOURCE_PROVIDER_ARTIFACT_TTL=5m
# Срок жизни выходного артефакта задания.
OUTPUT_PROVIDER_ARTIFACT_TTL=5m

# Максимум одновременно обещанных worker заданий.
WORKER_FREE_SLOTS=4
# Память worker, заявляемая планировщику, МБ.
WORKER_AVAILABLE_MEMORY_MB=2048
# Интервал heartbeat worker к Coordinator.
WORKER_HEARTBEAT_DELAY=100ms
# Пауза основного цикла выполнения заданий.
WORKER_WORKER_DELAY=10ms
