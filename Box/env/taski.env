# Режим логирования Taski: prod, docker или dev.
ENV=prod
# Адрес HTTP API Taski внутри контейнера.
HTTP_SERVER_ADDR=0.0.0.0:5252
# Адрес Prometheus metrics Taski внутри сети.
HTTP_SERVER_METRICS_ADDR=0.0.0.0:9090

# Число обработчиков очистки временных bucket.
FILESTORAGE_TRASHER_WORKERS=1
# Пауза сборщика просроченных bucket, секунд.
FILESTORAGE_TRASHER_COLLECTOR_ITERATIONS_DELAY=60
# Пауза обработчика удаления, секунд.
FILESTORAGE_TRASHER_WORKER_ITERATIONS_DELAY=5

# Подключение Taski к PostgreSQL. Значения должны совпадать с taski-postgres.env.
DB_CONNECTION_STRING="host=taski-postgres port=5432 database=taski user=taski password=coduels-change-me"
# Максимальное ожидание инициализации БД Taski.
DB_INIT_TIMEOUT=5m

# Endpoint запуска execution в Coordinator.
EXECUTE_ENDPOINT=http://coordinator:5253
# Адрес, по которому worker скачивает файлы задачи.
EXECUTE_DOWNLOAD_TASK_ENDPOINT=http://taski:5252

# Получать статусы Exesh через REST, не через Kafka.
EVENT_CONSUMER_MODE=rest
# Kafka brokers отсутствуют и в REST-режиме не используются.
EVENT_CONSUMER_BROKERS=
# Неактивное имя Kafka topic.
EVENT_CONSUMER_TOPIC=exesh.step-updates
# Неактивный Kafka consumer group.
EVENT_CONSUMER_GROUP_ID=taski
# Неактивная задержка Kafka fetch.
EVENT_CONSUMER_FETCH_INTERVAL=50ms
# Endpoint REST-истории сообщений Exesh.
EVENT_CONSUMER_REST_ENDPOINT=http://coordinator:5253
# Интервал REST-опроса Exesh.
EVENT_CONSUMER_POLL_INTERVAL=250ms
# Максимум сообщений за один REST-опрос.
EVENT_CONSUMER_MESSAGES_COUNT=100
# Kafka SASL отключён.
EVENT_CONSUMER_SASL_AUTH=false
EVENT_CONSUMER_SASL_USERNAME=
EVENT_CONSUMER_SASL_PASSWORD=

# Не отправлять события Taski в Kafka.
MESSAGE_DISPATCHER_KAFKA_ENABLED=false
# Kafka brokers отсутствуют.
MESSAGE_DISPATCHER_KAFKA_BROKERS=
# Неактивное имя Kafka topic.
MESSAGE_DISPATCHER_TOPIC=taski.testing
# Kafka SASL отключён.
MESSAGE_DISPATCHER_SASL_AUTH=false
MESSAGE_DISPATCHER_SASL_USERNAME=
MESSAGE_DISPATCHER_SASL_PASSWORD=

# Интервал обновления прикладных метрик.
METRICS_COLLECTOR_COLLECT_INTERVAL=5s
# Список тем задач через запятую; пустой список допустим.
TASK_TOPICS=
