# Адрес HTTP-сервера Duely внутри сети Docker.
ASPNETCORE_URLS=http://+:5001

# Подключение Duely к PostgreSQL. Значения должны совпадать с duely-postgres.env.
DbConnection__ConnectionString=Server=duely-postgres:5432;Database=duely;Username=duely;Password=coduels-change-me

# Ключ подписи JWT. Обязательно замените его перед публичным запуском.
JwtToken__SecretKey=change-this-jwt-secret-before-exposing-coduels-to-the-internet

# Длительность дуэли по умолчанию, минут.
Duel__DefaultMaxDurationMinutes=30
# Соответствие диапазонов рейтинга уровням сложности задач.
Duel__RatingToTaskLevelMapping__0__Rating=0-599
Duel__RatingToTaskLevelMapping__0__Level=1
Duel__RatingToTaskLevelMapping__1__Rating=600-899
Duel__RatingToTaskLevelMapping__1__Level=2
Duel__RatingToTaskLevelMapping__2__Rating=900-1199
Duel__RatingToTaskLevelMapping__2__Level=3
Duel__RatingToTaskLevelMapping__3__Rating=1200-1499
Duel__RatingToTaskLevelMapping__3__Level=4
Duel__RatingToTaskLevelMapping__4__Rating=1500-1799
Duel__RatingToTaskLevelMapping__4__Level=5
Duel__RatingToTaskLevelMapping__5__Rating=1800-2099
Duel__RatingToTaskLevelMapping__5__Level=6
Duel__RatingToTaskLevelMapping__6__Rating=2100-2399
Duel__RatingToTaskLevelMapping__6__Level=7
Duel__RatingToTaskLevelMapping__7__Rating=2400-2699
Duel__RatingToTaskLevelMapping__7__Level=8
Duel__RatingToTaskLevelMapping__8__Rating=2700-2999
Duel__RatingToTaskLevelMapping__8__Level=9
Duel__RatingToTaskLevelMapping__9__Rating=3000-9999
Duel__RatingToTaskLevelMapping__9__Level=10

# Интервал WebSocket keepalive, мс.
WebSocketConnection__KeepAliveIntervalMs=5000
# Тайм-аут закрытия WebSocket, мс.
WebSocketConnection__CloseTimeoutMs=1000
# Интервал синхронизации турниров, мс.
TournamentSynchronizationJob__CheckIntervalMs=1000
# Интервал фонового анализа действий, мс.
AnticheatBackgroundService__CheckIntervalMs=5000
# Удалять действия после анализа.
AnticheatBackgroundService__ShouldCleanupUserActions=true
# Интервал опроса transactional outbox, мс.
Outbox__CheckIntervalMs=250
# Максимальный размер пачки outbox.
Outbox__BatchSize=200
# Начальная задержка повторной отправки outbox, мс.
Outbox__InitialRetryDelayMs=100
# Максимальная задержка повторной отправки outbox, мс.
Outbox__MaxRetryDelayMs=30000
# Интервал проверки завершения дуэлей, мс.
DuelEndWatcherJob__CheckIntervalMs=1000
# Интервал поиска пар для дуэлей, мс.
DuelMakingJob__CheckPairIntervalMs=1000
# Интервал обслуживания ботов рейтинговых дуэлей, мс.
RankedDuelBots__CheckIntervalMs=5000
# Лимит отправок решений на пользователя в минуту.
RateLimiting__SubmissionsPerMinute=10
# Лимит пробных запусков кода на пользователя в минуту.
RateLimiting__RunsPerMinute=30

# Внутренний адрес Taski.
Taski__BaseUrl=http://taski:5252
# Получать статусы Taski через REST, без Kafka.
Taski__StatusUpdates__Mode=rest
# Число сообщений Taski за один REST-опрос.
Taski__StatusUpdates__Count=20
# Интервал REST-опроса Taski, мс.
Taski__StatusUpdates__PollIntervalMs=1000
# Внутренний адрес Exesh Coordinator.
Exesh__BaseUrl=http://coordinator:5253
# Получать статусы Exesh через REST, без Kafka.
Exesh__StatusUpdates__Mode=rest
# Число сообщений Exesh за один REST-опрос.
Exesh__StatusUpdates__Count=50
# Интервал REST-опроса Exesh, мс.
Exesh__StatusUpdates__PollIntervalMs=2000
# Внутренний адрес Analyzer.
Analyzer__BaseUrl=http://analyzer:8000

# Kafka-настройки оставлены явными, но не используются при обоих REST-режимах выше.
Kafka__BootstrapServers=
Kafka__TaskiTopic=taski.testing
Kafka__ExeshTopic=exesh.step-updates
Kafka__GroupId=duely
Kafka__SaslAuth=false
Kafka__SaslUsername=
Kafka__SaslPassword=

# Включить встроенную Prometheus telemetry Duely.
Otel__IsEnabled=true
# Имя сервиса в OpenTelemetry resource.
Otel__ServiceName=Duely
# Имя meter, публикующего метрики Duely.
Otel__MeterName=Duely
